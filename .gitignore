*.py[cod]
*.egg-info/

# 子包构建产物
packages/**/dist/

# Expo（历史遗留路径）
app/.expo/

# Tauri
desktop/src-tauri/target/

# 报告输出（含敏感扫描结果）
reports/
test-reports/

